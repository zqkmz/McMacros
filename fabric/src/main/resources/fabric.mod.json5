{
  "schemaVersion": 1,
  "id": "mcmacros",
  "version": "${version}",
  "name": "McMacros",
  "description": "使いやすく改造したマクロmod。JsMacros Community Edition をもとにしています。\nEasy-to-use macro mod, based on JsMacros Community Edition.",
  "authors": [
    "McMacros"
  ],
  "contributors": [
    "East_Arctica (JsMacros CE)",
    "wagyourtail (JsMacros)"
  ],
  "contact": {
    "sources": "https://github.com/JsMacrosCE/JsMacros"
  },
  "license": "MPL-2.0",
  "icon": "assets/jsmacrosce/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "com.jsmacrosce.jsmacros.fabric.client.JsMacrosFabric"
    ],
    "client": [
      "com.jsmacrosce.jsmacros.fabric.client.JsMacrosFabric"
    ],
    "modmenu": [
      "com.jsmacrosce.jsmacros.fabric.client.ModMenuEntry"
    ]
  },
  "mixins": [
    "jsmacrosce-common.mixins.json",
    "jsmacrosce-fabric.mixins.json"
  ],
  "accessWidener": "accesswideners/${access_widener}",
  "depends": {
    "fabricloader": ">=0.15.0",
    "fabric-api": "*",
      "minecraft": "${fabric_minecraft_version_range}"
  }
}
